{
  "name": "runcast",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "preview": "npm run preview -w app",
    "test": "npm run test -w @runcast/shared",
    "test:e2e": "npm run test:e2e -w app",
    "typecheck": "npm run typecheck -w @runcast/shared && npm run typecheck -w app",
    "lint": "npm run lint -w app",
    "db:types": "./node_modules/.bin/supabase gen types typescript --local --schema public > app/src/types/database.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supabase": "^2.39.2"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.13"
  }
}
